{
  "name": "bali-academy-admin",
  "version": "0.1.0",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "com.bali.academy.admin",
    "productName": "BALI Academy Admin",
    "files": ["main.cjs","preload.cjs","index.html","renderer.js","styles.css"],
    "win": {"target":"nsis"},
    "nsis": {"oneClick":false,"allowToChangeInstallationDirectory":true}
  }
}
